NODE_ENV=development
PORT=8000
# Must be a replica set (transactions). Local: docker run -p 27017:27017 mongo:7 --replSet rs0 && mongosh --eval "rs.initiate()"
MONGODB_URI=mongodb://localhost:27017/constructease?replicaSet=rs0
# 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173
# lax (same-site deploys) or none (API and web on different sites; requires HTTPS)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# PDF rendering: a remote Chrome (e.g. browserless) WebSocket URL, or a local Chrome via CHROME_PATH.
# Leave both empty in development: an installed Chrome/Edge/Brave is found automatically.
PDF_BROWSER_WS_ENDPOINT=
CHROME_PATH=
# Reverse geocoding for check-ins (Nominatim-compatible). Leave empty to disable.
GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
GEOCODER_USER_AGENT=ConstructEase/2.0 (ops contact: set-me)
# Run PDF/Excel jobs inside the API process. Default: true in development, false otherwise (run dist/worker.js).
RUN_JOBS_IN_API=
LOG_LEVEL=info
